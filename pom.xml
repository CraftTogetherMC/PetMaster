<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.hm</groupId>
	<artifactId>petmaster</artifactId>
	<version>1.12.7</version>
	<name>PetMaster</name>
	<description>Manage pets and display useful information via holograms, action bar or chat messages!</description>
	<url>https://github.com/leothawne/PetMaster</url>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/leothawne/PetMaster/issues</url>
	</issueManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Java für MC 26.2 -->
		<maven.compiler.release>25</maven.compiler.release>

		<!-- Paper API -->
		<paper.api.version>26.2.build.111-stable</paper.api.version>

		<!-- Vault / Holograms -->
		<vaultapi.version>1.7.1</vaultapi.version>
		<decentholograms.version>2.10.1</decentholograms.version>

		<!-- Dein Shared Modul -->
		<mcshared.version>1.1.9</mcshared.version>
	</properties>

	<repositories>
		<!-- Paper/Purpur Upstream -->
		<repository>
			<id>papermc</id>
			<url>https://repo.papermc.io/repository/maven-public/</url>
		</repository>

		<!-- Jitpack (z.B. VaultAPI, DecentHolograms je nach Artifact) -->
		<repository>
			<id>jitpack</id>
			<url>https://jitpack.io/</url>
		</repository>

		<!-- Dein MCShared Repo (beibehalten) -->
		<repository>
			<id>mcshared-repo</id>
			<url>https://raw.github.com/Sidpatchy/MCShared/mvn-repo/</url>
		</repository>

		<!-- optional beibehalten, falls andere Transitives hier liegen -->
		<repository>
			<id>codemc-repo</id>
			<url>https://repo.codemc.io/repository/maven-public/</url>
		</repository>
	</repositories>

	<build>
		<finalName>${project.name}-${project.version}</finalName>

		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.1</version>
				<configuration>
					<release>${maven.compiler.release}</release>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<configuration>
					<relocations>
						<relocation>
							<pattern>com.hm.mcshared</pattern>
							<shadedPattern>com.hm.petmaster</shadedPattern>
							<excludes>
								<exclude>com.hm.mcshared.event.*</exclude>
							</excludes>
						</relocation>
					</relocations>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- Paper API (Purpur kompatibel) -->
		<dependency>
			<groupId>io.papermc.paper</groupId>
			<artifactId>paper-api</artifactId>
			<version>${paper.api.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Vault API (Runtime kommt vom Server/Plugin) -->
		<dependency>
			<groupId>com.github.MilkBowl</groupId>
			<artifactId>VaultAPI</artifactId>
			<version>${vaultapi.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- DecentHolograms API (Runtime kommt vom Server/Plugin) -->
		<dependency>
			<groupId>com.github.decentsoftware-eu</groupId>
			<artifactId>decentholograms</artifactId>
			<version>${decentholograms.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- MCShared (wird weiterhin geshadet) -->
		<dependency>
			<groupId>com.hm.mcshared</groupId>
			<artifactId>MCShared</artifactId>
			<version>${mcshared.version}</version>
		</dependency>
	</dependencies>

</project>
